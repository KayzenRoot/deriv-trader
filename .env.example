# Deriv Trader — environment template (DT-WP-01 Phase E)
# Variable names and safe descriptions only. Never commit real URLs/tokens/keys.
# Copy to .env for local development; .env is git-ignored.

# --- General ---
# Application environment: development | test | production
NODE_ENV=development
# Product environment gate: DEMO is default. REAL is represented but not enabled for execution in WP-01.
DERIV_TRADER_ENV=DEMO
# Local data root (relative to repo). Runtime Parquet/DuckDB artifacts live here and are git-ignored.
DERIV_TRADER_DATA_ROOT=./data

# --- Trader Worker (apps/trader) ---
# Loopback-only by default. Do not set to 0.0.0.0 unless a governed remote-access design is approved.
TRADER_HOST=127.0.0.1
TRADER_PORT=3101
# Build SHA injected at build/CI time (optional locally).
BUILD_SHA=local-dev

# --- Web (apps/web) ---
PORT=3000
# Public trader URL used by the web status screen (server-side fetch only, no secrets).
TRADER_INTERNAL_URL=http://127.0.0.1:3101

# --- Supabase (skeleton only in WP-01; no real project required) ---
# Public anon-safe values only in real use; keep blank locally.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role keys must NEVER be exposed to the browser. Local-only, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# --- Deriv (metadata only in WP-01; no real broker calls) ---
# No tokens here. Tokens are accessed at runtime only through SecretStore in the trader worker.
# Current Options API baseline (public surfaces only). Authenticated demo/real
# sockets are obtained at runtime from the account OTP response, never hardcoded.
DERIV_APP_ID=
DERIV_OPTIONS_REST_BASE_URL=https://api.derivws.com
DERIV_OPTIONS_PUBLIC_WS_URL=wss://api.derivws.com/trading/v1/options/ws/public

# --- Deriv public transport tuning (DT-WP-02; documented defaults) ---
DERIV_WS_REQUEST_TIMEOUT_MS=15000
DERIV_WS_HEARTBEAT_MS=30000
DERIV_WS_RECONNECT_BASE_MS=1000
DERIV_WS_RECONNECT_MAX_MS=30000

# --- API budgets: documented Deriv defaults at DT-WP-02 compile time ---
# Proposal group is shared with future buy/sell/open-contract; do not raise
# scanner usage above the reserve. Limits may change; config wins over code.
API_BUDGET_PROPOSAL_PER_MIN=360
API_BUDGET_PROPOSAL_PER_HOUR=14400
API_BUDGET_OTHER_PER_MIN=220
API_BUDGET_OTHER_PER_HOUR=14400
API_BUDGET_PROPOSAL_RESERVE=0.3
# REST IP windows per official limits (authenticated-user 80/min deferred:
# WP-02 performs no authenticated REST; no fabricated hourly REST limit).
API_BUDGET_REST_PER_MIN=300
API_BUDGET_REST_PER_10MIN=1000

# --- Scanner economics (DT-WP-02) ---
# Probe amount is a read-only quote assumption, NOT the user trading stake.
SCANNER_PAYOUT_THRESHOLD=0.8
SCANNER_PROBE_AMOUNT=10
SCANNER_PROBE_CURRENCY=USD
SCANNER_PROBE_BASIS=stake
SCANNER_PROPOSAL_TTL_MS=30000
# Freshness authority TTLs/tolerances (operational tuning, not edge assumptions)
SCANNER_REGISTRY_TTL_MS=1800000
SCANNER_CAPABILITY_TTL_MS=900000
SCANNER_SKEW_TOLERANCE_S=60
# Continuous read-only loop cadence (bounded, overlap-guarded)
SCANNER_LOOP_UNIVERSE_MS=60000
SCANNER_LOOP_PULSE_MS=15000

# --- Local capture (DT-WP-02) ---
CAPTURE_BATCH_ROWS=500
CAPTURE_ROLL_MS=60000
DATA_DISK_WARN_MB=1024
DATA_DISK_STOP_MB=256
