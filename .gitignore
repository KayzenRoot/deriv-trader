# Env / secrets (never commit real credentials)
.env
.env.*
!.env.example
secrets/
credentials/
*.pem
*.key

# Dependencies
node_modules/

# Builds
dist/
build/
.next/
out/
*.tsbuildinfo
tsconfig.tsbuildinfo
next-env.d.ts

# Coverage / test output
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/

# Logs
*.log
logs/
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Supabase local artifacts
.supabase/
supabase/.branches/
supabase/.temp/

# Local data runtime (keep intentional fixtures only).
# Committed fixtures live under packages/*/fixtures/; everything generated
# under data/ at runtime (partitions, manifests, quarantine) stays local.
data/*.parquet
data/*.duckdb
data/*.db
data/*.sqlite
data/normalized/
data/proposals/
data/manifests/
data/quarantine/
data/research/
data/runtime/
data/tmp/
!data/.gitkeep

# Misc
.cache/
.tmp/
*.tmp